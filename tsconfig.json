{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/test-support", "services/*/src", "services/*/test", "services/*/eval", "scripts/test", "scripts/make-invoice-pdfs.ts", "scripts/setup-treasury.ts"]
}
