    "xrpl": "tsx services/backend/src/xrpl-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
