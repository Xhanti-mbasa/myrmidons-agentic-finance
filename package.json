{
  "name": "myrmidons-agentic-finance",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "fixtures:pdf": "node scripts/make-invoice-pdfs.ts",
    "setup:treasury": "tsx scripts/setup-treasury.ts",
    "kill-switch": "tsx scripts/kill-switch.ts",
    "agent:invoice": "tsx services/agent/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "db:migrate": "pnpm --filter @shucamoxa/db migrate",
    "db:seed": "pnpm --filter @shucamoxa/db seed",
    "dev:mock": "SHUCAMOXA_MOCK=1 pnpm --filter @shucamoxa/mock-backend start",
    "mutate": "pnpm --filter @shucamoxa/agent mutate",
    "xrpl": "tsx services/backend/src/xrpl-demo.ts",
    "harness:demo": "tsx services/backend/src/harness/main.ts --demo",
    "harness:start": "tsx services/backend/src/harness/main.ts",
    "demo:start": "python3 scripts/start-local-demo.py",
    "demo:check": "tsx scripts/demo-scenarios.ts",
    "demo:conversation": "tsx scripts/conversation-scenarios.ts",
    "test:demo": "vitest run services/backend/test/harness.test.ts services/backend/test/demo-scenarios.test.ts"
  },
  "devDependencies": {
    "@shucamoxa/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "xrpl": "^5.3.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  }
}
