{
  "name": "myrmidons-agentic-finance",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "fixtures:pdf": "node scripts/make-invoice-pdfs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "db:migrate": "pnpm --filter @shucamoxa/db migrate",
    "db:seed": "pnpm --filter @shucamoxa/db seed",
