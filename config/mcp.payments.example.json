{
  "mcpServers": {
    "payments": {
      "command": "{python}",
      "args": ["mcp_gateway/server.py"],
      "cwd": "..",
      "env": {
        "SHUCAMOXA_BACKEND_URL": "${SHUCAMOXA_BACKEND_URL}",
        "SHUCAMOXA_BACKEND_TOKEN": "${SHUCAMOXA_BACKEND_TOKEN}",
        "SHUCAMOXA_BUSINESS_SCOPE": "${SHUCAMOXA_BUSINESS_SCOPE}"
      }
    }
  }
}
