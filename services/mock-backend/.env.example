# Shucamoxa dev mock backend (T15). DEV ONLY, NEVER DEPLOY. Names and placeholders only.
# SHUCAMOXA_MOCK=1 is NOT read from here: it must come from the command (`pnpm dev:mock`).
# Tokens: at least 32 characters, different from each other. Generate with `openssl rand -base64 32`.
# MOCK_AGENT_TOKEN must equal the agent's AGENT_BACKEND_TOKEN (services/agent/.env).
MOCK_AGENT_TOKEN=replace-me
# Only for POST /dev/kill-switch. Never give this one to the agent.
MOCK_OWNER_TOKEN=replace-me-too
MOCK_PORT=8787
