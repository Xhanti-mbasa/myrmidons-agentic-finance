# Shucamoxa agent service (W1). Names and placeholders only: never put real values here.
# The agent must never hold a wallet seed, private key or database URL; startup refuses them.
# Only the names below may appear in services/agent/.env; any other name is refused at startup.
# Generate tokens as base64: `openssl rand -base64 32`.
# Point this to your OWN OpenAI-compatible model server; Open WebUI uses the same upstream.
# Local Ollama: http://127.0.0.1:11434/v1; teammate SSH tunnel: http://127.0.0.1:11435/v1
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=replace-with-installed-model-name
MODEL_API_KEY=
MODEL_FALLBACK_HOST=
# A bare origin: http only for localhost or Tailscale, otherwise https. No path or trailing slash.
BACKEND_URL=http://127.0.0.1:8787
AGENT_BACKEND_TOKEN=replace-me
# Read by the agent's HTTP service (T12).
AGENT_INBOUND_TOKEN=
AGENT_HOST=127.0.0.1
AGENT_PORT=8790
LOG_LEVEL=info
